export function matchesCollectionSubCategory(product: Product, subCategory?: string): boolean {
  if (!subCategory || subCategory === 'all') return true;
  const subLower = subCategory.toLowerCase();
  
  if (subLower.includes("men's") || subLower.includes("mens")) {
    return product.gender === 'men' || product.gender === 'unisex';
  }
  if (subLower.includes("women's") || subLower.includes("womens")) {
    return product.gender === 'women' || product.gender === 'unisex';
  }
  if (subLower.includes("kid") || subLower.includes("children") || subLower.includes("teen")) {
    return product.gender === 'kids' || 
           product.subCategory.toLowerCase().includes('kid') || 
           product.subCategory.toLowerCase().includes('teen');
  }
  if (subLower.includes("active") || subLower.includes("sport")) {
    return product.subCategory.toLowerCase().includes('active') || 
           product.subCategory.toLowerCase().includes('sport') ||
           product.name.toLowerCase().includes('active') ||
           product.name.toLowerCase().includes('sport') ||
           product.frameShape === 'wrap';
  }
  if (subLower.includes("toric") || subLower.includes("astigmatism")) {
    return product.isToric === true ||
           product.subCategory.toLowerCase().includes('toric') || 
           product.name.toLowerCase().includes('toric') ||
           product.name.toLowerCase().includes('astigmatism');
  }
  if (subLower.includes("lens care") || subLower.includes("care") || subLower.includes("solution") || subLower.includes("accessories")) {
    return product.subCategory.toLowerCase().includes('care') || 
           product.subCategory.toLowerCase().includes('solution') ||
           product.subCategory.toLowerCase().includes('accessories') ||
           product.name.toLowerCase().includes('solution') ||
           product.name.toLowerCase().includes('spray') ||
           product.name.toLowerCase().includes('cleaner') ||
           product.name.toLowerCase().includes('hook') ||
           product.name.toLowerCase().includes('rope') ||
           product.name.toLowerCase().includes('box') ||
           product.name.toLowerCase().includes('kit');
  }

  return product.subCategory.toLowerCase().includes(subLower) || 
         product.name.toLowerCase().includes(subLower);
}

