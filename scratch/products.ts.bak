export interface ProductReview {
  id: string;
  author: string;
  location: string;
  rating?: number;
  date: string;
  title: string;
  comment: string;
  verified: boolean;
}

export interface ProductVariantColor {
  name: string;
  hex: string;
  image?: string;
}

export interface FrameMeasurements {
  lensWidth: number; // e.g. 52 mm
  bridgeWidth: number; // e.g. 18 mm
  templeLength: number; // e.g. 145 mm
  frameWeight: string; // e.g. "18.5g (Ultra-Light)"
}

export type ProductCategory = 
  | 'eyeglasses' 
  | 'sunglasses' 
  | 'tint-eyeglasses' 
  | 'clear-contacts' 
  | 'color-contacts' 
  | 'accessories';

export type ProductGender = 'men' | 'women' | 'unisex' | 'kids';

export type FrameShape = 'aviator' | 'cat-eye' | 'round' | 'square' | 'rectangle' | 'rectangular' | 'browline' | 'geometric' | 'wrap';

export type LensDisposability = 'daily' | 'monthly' | 'three-month' | 'six-month' | 'yearly';

export type RimType = 'Full Rim' | 'Semi-Rimless' | 'Rimless';

export interface Product {
  id: string;
  name: string;
  sku: string;
  category: ProductCategory;
  subCategory: string;
  gender: ProductGender;
  brand: string;
  price: number; // PKR
  originalPrice?: number; // PKR
  rating?: number;
  reviewCount?: number;
  images: string[];
  description: string;
  features: string[];
  inStock: boolean;
  isNew?: boolean;
  isBestSeller?: boolean;
  frameShape?: FrameShape;
  frameMaterial?: string;
  rimType?: RimType;
  frameSize?: string;
  measurements?: FrameMeasurements;
  disposability?: LensDisposability;
  lensColor?: string;
  availableColors: ProductVariantColor[];
  reviews?: ProductReview[];
}

export function matchesCollectionSubCategory(product: Product, subCategory?: string): boolean {
  if (!subCategory || subCategory === 'all') return true;
  const subLower = subCategory.toLowerCase();
  
  if (subLower.includes("men's") || subLower.includes("mens")) {
    return product.gender === 'men' || product.gender === 'unisex';
  }
  if (subLower.includes("women's") || subLower.includes("womens")) {
    return product.gender === 'women' || product.gender === 'unisex';
  }
  if (subLower.includes("kid") || subLower.includes("children") || subLower.includes("teen")) {
    return product.gender === 'kids' || 
           product.subCategory.toLowerCase().includes('kid') || 
           product.subCategory.toLowerCase().includes('teen');
  }
  if (subLower.includes("active") || subLower.includes("sport")) {
    return product.subCategory.toLowerCase().includes('active') || 
           product.subCategory.toLowerCase().includes('sport') ||
           product.name.toLowerCase().includes('active') ||
           product.name.toLowerCase().includes('sport') ||
           product.frameShape === 'wrap';
  }
  if (subLower.includes("toric") || subLower.includes("astigmatism")) {
    return product.subCategory.toLowerCase().includes('toric') || 
           product.name.toLowerCase().includes('toric') ||
           product.name.toLowerCase().includes('astigmatism');
  }
  if (subLower.includes("lens care") || subLower.includes("care")) {
    return product.subCategory.toLowerCase().includes('care') || 
           product.name.toLowerCase().includes('solution') ||
           product.name.toLowerCase().includes('spray');
  }

  return product.subCategory.toLowerCase().includes(subLower) || 
         product.name.toLowerCase().includes(subLower);
}

